# Personal Claude Code subagents. Kept here because the desktop app does not read
# user-level ~/.claude/agents. They hard-code absolute paths on one machine, so
# they are local tooling, not repo content.
#
# `**/` because a pattern with an internal slash anchors to THIS directory, and
# skills/agents also load from nested .claude/ dirs — so a bare `.claude/agents/`
# left every workspace's own copy committable, which is the one thing the rule
# exists to prevent.
**/.claude/agents/

# Scratch UUID drop from the desktop app. Not referenced by anything tracked;
# ignored so `git add -A` can't sweep it into a commit.
_cancel.txt

# Audio dropped here only so the app can play it — the client refuses to open
# files outside the working directory. Originals live in Documents/ComfyUI/output.
audio-review/

# Recorded demo runs — video + per-beat screenshots, regenerated by
# tests/demo/foobar-demo.mjs. The script is source; its output is not.
apps/timeline-gstudio001/tests/demo/out/

# Python virtual environments & caches
apps/backend/venv/
apps/backend/.venv/
__pycache__/
*.pyc
