{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "timeline-gstudio001",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/timeline-gstudio001",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "timeline-gstudio001-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "media-monster",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/media-monster",
        "run",
        "dev"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/storybook",
        "run",
        "storybook"
      ],
      "port": 6006
    },
    {
      "name": "timeline-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/timeline-gstudio001",
        "run",
        "start",
        "--",
        "-p",
        "3002"
      ],
      "port": 3002,
      "autoPort": false
    }
  ]
}
