GEMINI_API_KEY=

# Firebase Admin SDK
# Option A: explicit service account values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# Option B: omit the service-account values above and set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path in the host environment.
# FIREBASE_STORAGE_BUCKET is still required.
