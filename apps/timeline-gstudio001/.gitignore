node_modules/
.next/
coverage/
storybook-static/
test-results/
playwright-report/
.DS_Store
*.log
.env*
!.env.example

# Vite intermediate output for the MCP Apps UI; the committed artifact is lib/mcp-apps/timeline-app-html.ts
mcp-app/dist/

# Written by `npm run audit:orphans` so --offline can re-answer questions
# without re-reading the collection. Local cache; never committed.
.orphan-snapshot.json

# Written by `npm run correct:aspects` — one ffprobe reading per source URL, so
# a re-run does not hit the media host again. Local cache; never committed.
.aspect-probe-cache.json
fixtures/scale-probe.json

# The scratch offline board: whatever `POST /api/timelines/import` last wrote,
# i.e. somebody's exported project. Personal working state, and the one fixture
# that IS meant to be overwritten — the import route refuses the generated ones.
fixtures/local.json

# Offline-mode media: files the upload route writes when GSTUDIO_FIXTURE_TIMELINES
# is set, served statically at /offline-media. Local testing artefacts.
public/offline-media/

# One-off artefact of `repair:asset-paths` — the originals it rewrote, kept
# next to the script for a hand reversal. Operational data, not source.
repair-truncated-asset-paths.backup.json
