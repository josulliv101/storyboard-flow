{
  "name": "timeline-gstudio001",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run lint && npm run build --workspace=@storyboard/timeline-widget && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fixture:build": "node scripts/make-dev-fixture.mjs",
