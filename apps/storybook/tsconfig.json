{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../web/*"],
      "@storyboard/db": ["../../packages/db"],
      "@storyboard/db/*": ["../../packages/db/*"],
      "@storyboard/ui": ["../../packages/ui"],
      "@storyboard/ui/*": ["../../packages/ui/*"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "../web/components/**/*.ts",
    "../web/components/**/*.tsx",
    "../../packages/ui/**/*.ts",
    "../../packages/ui/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
